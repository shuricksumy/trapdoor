# Separate containers: copy to .env next to docker-compose.yml.
TD_AGENT_TOKEN=change-me-openssl-rand-hex-32
TD_TZ=UTC
# Each VPN type's folder (mounted only into its own vpn container, and into the agent)
OPENVPN_DIR=./openvpn
WIREGUARD_DIR=./wireguard
AMNEZIAWG_DIR=./amneziawg
# Ports: create the first server of each type with these (the same inside and outside,
# except the first OpenVPN server, which listens on 1194 inside)
VPN_PORT=1194
VPN_PROTO=udp
VPN2_PORT=1195
VPN2_PROTO=tcp
WG_PORT=51820
AWG_PORT=51830
WEB_BIND=127.0.0.1:8080
# VPN_NAT_IFACE=eth0       # WireGuard / AmneziaWG NAT interface, if the default is wrong
# TD_COOKIE_SECURE=false   # only for testing over plain HTTP
