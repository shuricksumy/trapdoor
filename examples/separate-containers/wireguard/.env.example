# Separate containers, part 2 (WireGuard + AmneziaWG). Copy to .env.
# Its own token, not the one of the openvpn stack.
TD_AGENT_TOKEN=change-me-openssl-rand-hex-32
WIREGUARD_DIR=./wireguard
AMNEZIAWG_DIR=./amneziawg
WG_PORT=51820
AWG_PORT=51830
# The agent's port (TLS): reached on the network "trapdoor", or on the host with
# docker-compose.host.yml (then choose a free one)
AGENT_PORT=9443
