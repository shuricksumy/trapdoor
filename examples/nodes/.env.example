# Nodes: copy to .env next to docker-compose.yml.
# Each agent has its own token: openssl rand -hex 32
TD_AGENT_TOKEN=change-me-main
TD_OFFICE_AGENT_TOKEN=change-me-office
TD_GUEST_AGENT_TOKEN=change-me-guest
# Lets the nodes in this file join the web UI (at least 24 characters): openssl rand -hex 24
TD_JOIN_SECRET=change-me-openssl-rand-hex-24
# The machine all three nodes run on, as the UI shows it
TD_MACHINE=docker-host
TD_TZ=UTC
WEB_BIND=127.0.0.1:8080
# Ports per node (create servers with these; the first OpenVPN server of a node listens on 1194 inside)
MAIN_OVPN_PORT=1194
MAIN_OVPN2_PORT=1195
MAIN_WG_PORT=51820
MAIN_AWG_PORT=51830
OFFICE_OVPN_PORT=1294
OFFICE_WG_PORT=51920
OFFICE_AWG_PORT=51930
GUEST_OVPN_PORT=1394
GUEST_WG_PORT=52020
GUEST_AWG_PORT=52030
# TD_COOKIE_SECURE=false   # only for testing over plain HTTP
