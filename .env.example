# Copy to .env and adjust. Never commit .env.

# Shared secret between web and agent (long and random):  openssl rand -hex 32
TD_AGENT_TOKEN=

# Time zone for day / month / year boundaries in traffic reports (IANA name)
TD_TZ=UTC

# OpenVPN directory on the host (server.conf, easy-rsa/pki, ...)
OPENVPN_DIR=./openvpn
# Port and protocol published for VPN clients (OpenVPN listens on 1194 inside)
VPN_PORT=1194
VPN_PROTO=udp
# A second OpenVPN server (added in trapdoor, e.g. TCP 443 for strict networks):
# the same port inside and outside; add it with this port and protocol
VPN2_PORT=1195
VPN2_PROTO=tcp
# WireGuard: directory for its servers, and the UDP port published for them
# (the first WireGuard server listens on it; more servers need more ports here)
WIREGUARD_DIR=./wireguard
WG_PORT=51820
# AmneziaWG (WireGuard with obfuscation): the same for its servers
AMNEZIAWG_DIR=./amneziawg
AWG_PORT=51830
# NAT for VPN clients: auto = the "server" subnet of server.conf, a CIDR, or empty for none
VPN_NAT_SUBNET=auto
# Only for docker-compose.remote.yml (a machine managed from another one's web UI): where
# the agent API listens; AGENT_BIND limits it to one address (e.g. a Tailscale IP)
#AGENT_BIND=0.0.0.0
#AGENT_PORT=9443
# ... and how it joins the web UI by itself: Nodes → Add a node → With a join token shows these
#TD_JOIN_URL=https://vpn-admin.example.com
#TD_JOIN_TOKEN=tdj_...
#TD_NODE_NAME=vps
#TD_NODE_URL=https://203.0.113.5:9443
#TD_MACHINE=vps

# Web UI address on the host; keep it local and put an HTTPS reverse proxy in front
WEB_BIND=127.0.0.1:8080

# Only with docker-compose.traefik.yml: hostname and the external Traefik network
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# TD_HOSTNAME=vpn-admin.example.com
# TRAEFIK_NETWORK=proxy
# Only for a first plain-HTTP test: false sends the login cookie without HTTPS
TD_COOKIE_SECURE=true
# Reverse proxy addresses allowed to set X-Forwarded-For (CIDRs, comma-separated)
TD_TRUSTED_PROXIES=

# Optional token for scripts: Authorization: Bearer <token>
TD_WEB_API_TOKEN=

# Optional: nodes started with this secret as TD_JOIN_TOKEN join without a one-time token
# (for nodes you start yourself, e.g. in the same compose file; openssl rand -hex 24)
#TD_JOIN_SECRET=
# Optional: this machine and node as the UI shows them (default: "This machine", "main")
#TD_MACHINE=home-server
#TD_NODE_NAME=main

# Optional
# TD_EXPIRY_WARN_DAYS=30        # warn this many days before a client certificate expires
# TD_SESSION_IDLE=12h           # admin logout after this much inactivity
# TD_TOTP_ISSUER=trapdoor     # name shown in authenticator apps
# TD_IMAGE=ghcr.io/shuricksumy/trapdoor:latest   # or pin a release, e.g. :1.0
